# 会员系统配置文件
# 复制此文件为 vip.conf 并根据需要修改

# ********************************************************************************************** #
# 会员系统配置                                                                                   #
# ********************************************************************************************** #

# 是否启用会员系统
# 设置为 false 将禁用所有会员功能
MemberSystem.Enable = 1

# ********************************************************************************************** #
# 掉落率加成配置                                                                                 #
# 格式：小数 (0.2 = 20%, 1.0 = 100%)                                                           #
# ********************************************************************************************** #

# VIP0 (普通会员) 掉落率加成
MemberSystem.DropRateBonus.0 = 0

# VIP1 (高级会员) 掉落率加成 - 默认 20%
MemberSystem.DropRateBonus.1 = 0.2

# VIP2 (超级会员) 掉落率加成 - 默认 50%
MemberSystem.DropRateBonus.2 = 0.5

# VIP3 (至尊会员) 掉落率加成 - 默认 100%
MemberSystem.DropRateBonus.3 = 1.0

# ********************************************************************************************** #
# 天赋点数加成配置                                                                               #
# 格式：整数 (每 10 级奖励的天赋点数)                                                              #
# ********************************************************************************************** #

# VIP0 (普通会员) 天赋点数加成 - 每 10 级奖励 0 点
MemberSystem.TalentPointBonus.0 = 0

# VIP1 (高级会员) 天赋点数加成 - 每 10 级奖励 1 点
MemberSystem.TalentPointBonus.1 = 1

# VIP2 (超级会员) 天赋点数加成 - 每 10 级奖励 2 点
MemberSystem.TalentPointBonus.2 = 2

# VIP3 (至尊会员) 天赋点数加成 - 每 10 级奖励 5 点
MemberSystem.TalentPointBonus.3 = 5
